{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "public_gate_receipt_v1",
  "type": "object",
  "required": [
    "schema_version",
    "runner_repo",
    "runner_sha",
    "public_run_id",
    "public_job_id",
    "private_repo",
    "private_branch",
    "private_sha",
    "gate_id",
    "status_context",
    "request_id",
    "started_at",
    "completed_at",
    "exit_code",
    "result",
    "sanitized_metrics",
    "output_schema_hash",
    "private_content_public_exposure",
    "artifacts_created"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "runner_repo": {"const": "TheGor-365/ai-course-actions-runner"},
    "runner_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "public_run_id": {"type": ["string", "integer"]},
    "public_job_id": {"type": "string", "minLength": 1},
    "private_repo": {"type": "string", "minLength": 1},
    "private_branch": {"type": "string", "minLength": 1},
    "private_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "gate_id": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
    "status_context": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
    "started_at": {"type": "string"},
    "completed_at": {"type": "string"},
    "exit_code": {"type": "integer"},
    "result": {"enum": ["PASS", "FAIL", "ERROR"]},
    "sanitized_metrics": {"type": "object"},
    "output_schema_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "private_content_public_exposure": {"const": false},
    "artifacts_created": {"const": false}
  },
  "additionalProperties": true
}
